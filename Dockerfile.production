# syntax=docker/dockerfile:1

# Build from the Wishlist checkout (also when it is a deployment submodule):
# docker build -f Dockerfile.production -t wishlist:production .
ARG RUBY_VERSION=4.0.6
FROM ruby:${RUBY_VERSION}-slim-bookworm AS base

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y ca-certificates curl libjemalloc2 libpq5 libvips tzdata && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists/*

ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so" \
    PORT="3000"

FROM base AS build

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./

# Limit compilation concurrency on the small production host.
RUN bundle install --jobs 1 --retry 3 && \
    rm -rf /root/.bundle /usr/local/bundle/ruby/*/cache /usr/local/bundle/ruby/*/bundler/gems/*/.git && \
    bundle exec bootsnap precompile -j 1 --gemfile

COPY . .

RUN bundle exec bootsnap precompile -j 1 app/ lib/

# Database YAML evaluates ENV.fetch for development/test as well as production.
# These build-only placeholders do not connect to a database or survive as ENV
# settings in the runtime image. Real credentials are supplied at deployment.
RUN SECRET_KEY_BASE_DUMMY=1 \
    DEVISE_MAILER_SENDER=build@example.invalid \
    WISHLIST_DATABASE=wishlist_build \
    WISHLIST_DATABASE_USERNAME=build \
    WISHLIST_DATABASE_PASSWORD=build \
    WISHLIST_DATABASE_HOST=127.0.0.1 \
    WISHLIST_DATABASE_PORT=5432 \
    WISHLIST_TEST_DATABASE=wishlist_build_test \
    WISHLIST_TEST_DATABASE_USERNAME=build \
    WISHLIST_TEST_DATABASE_PASSWORD=build \
    WISHLIST_TEST_DATABASE_HOST=127.0.0.1 \
    WISHLIST_TEST_DATABASE_PORT=5432 \
    bundle exec rails assets:precompile

FROM base AS production

RUN groupadd --system --gid 1000 rails && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash rails

COPY --chown=rails:rails --from=build /usr/local/bundle /usr/local/bundle
COPY --chown=rails:rails --from=build /rails /rails

USER rails:rails

# Run db:prepare explicitly before starting web and worker containers.
# Nginx handles public HTTPS; Puma listens only on the container network.
EXPOSE 3000
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]
