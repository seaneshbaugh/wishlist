<div class="mx-auto w-full max-w-2xl space-y-10">
  <header>
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Delete Account</h1>
    <p class="mt-2 text-slate-500">Permanently delete your Wishlist account.</p>
  </header>

  <div class="rounded-lg border border-red-200 bg-red-50 p-5 text-sm leading-6 text-red-800">
    <p class="font-semibold">This cannot be undone.</p>
    <p class="mt-2">Your lists, items, purchases, friendships, and invitations will be deleted. Your friends' accounts and lists will remain.</p>
  </div>

  <% if @account.errors.any? %>
    <div role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <% @account.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with url: account_path, method: :delete, class: "space-y-10" do |form| %>
    <div>
      <%= form.label :confirmation, "Confirm your username", class: "block text-sm font-semibold text-slate-900" %>
      <p id="deletion-confirmation-help" class="mt-1 text-sm text-slate-500">
        Type <strong class="font-semibold text-slate-900"><%= @account.username %></strong> exactly as shown to confirm.
      </p>
      <%= form.text_field :confirmation,
          value: params[:confirmation],
          required: true,
          autocomplete: "off",
          autocapitalize: "none",
          spellcheck: false,
          aria: { describedby: "deletion-confirmation-help", invalid: @confirmation_error.present? },
          class: class_names(
            "mt-3 block w-full rounded-lg border bg-white px-4 py-3 shadow-sm transition",
            "border-red-300 focus:border-red-500 focus:ring-red-500" => @confirmation_error.present?,
            "border-slate-300 focus:border-blue-500 focus:ring-blue-500" => @confirmation_error.blank?
          ) %>
      <% if @confirmation_error.present? %>
        <p role="alert" class="mt-2 text-sm text-red-600"><%= @confirmation_error %></p>
      <% end %>
    </div>
    <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-8 sm:flex-row sm:justify-end">
      <%= link_to "Keep My Account", edit_account_path,
          class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <%= form.submit "Delete My Account",
          class: "rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-red-700" %>
    </div>
  <% end %>
</div>
