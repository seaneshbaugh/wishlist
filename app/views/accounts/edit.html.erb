<div class="mx-auto w-full max-w-2xl space-y-12">
  <%= form_with model: @account, scope: :account, url: account_path, method: :patch, class: "space-y-12" do |form| %>
    <header>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Edit Account</h1>
      <p class="mt-2 text-slate-500">Update your username, email address, or password.</p>
    </header>

    <% @account.errors.full_messages_for(:base).each do |message| %>
      <p role="alert" class="text-sm text-red-600"><%= message %></p>
    <% end %>

    <section class="space-y-10">
      <div>
        <%= form.label :username, class: "block text-sm font-semibold text-slate-900" %>
        <p id="account-username-help" class="mt-1 text-sm text-slate-500">Use 4–32 letters, numbers, or underscores, starting with a letter. Your username is also used in links to your lists.</p>
        <%= form.text_field :username,
            required: true,
            maxlength: 32,
            autocomplete: "username",
            autocapitalize: "none",
            spellcheck: false,
            aria: { describedby: "account-username-help", invalid: @account.errors[:username].any? },
            class: class_names(
              "mt-3 block w-full rounded-lg border bg-white px-4 py-3 shadow-sm transition",
              "border-red-300 focus:border-red-500 focus:ring-red-500" => @account.errors[:username].any?,
              "border-slate-300 focus:border-blue-500 focus:ring-blue-500" => @account.errors[:username].empty?
            ) %>
        <% @account.errors.full_messages_for(:username).each do |message| %>
          <p role="alert" class="mt-2 text-sm text-red-600"><%= message %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :email, class: "block text-sm font-semibold text-slate-900" %>
        <p id="account-email-help" class="mt-1 text-sm text-slate-500">Changing your email requires your current password. Your existing address stays in use until you confirm the new one.</p>
        <%= form.email_field :email,
            required: true,
            autocomplete: "email",
            aria: { describedby: "account-email-help", invalid: @account.errors[:email].any? },
            class: class_names(
              "mt-3 block w-full rounded-lg border bg-white px-4 py-3 shadow-sm transition",
              "border-red-300 focus:border-red-500 focus:ring-red-500" => @account.errors[:email].any?,
              "border-slate-300 focus:border-blue-500 focus:ring-blue-500" => @account.errors[:email].empty?
            ) %>
        <% @account.errors.full_messages_for(:email).each do |message| %>
          <p role="alert" class="mt-2 text-sm text-red-600"><%= message %></p>
        <% end %>
        <% if @account.pending_reconfirmation? %>
          <p class="mt-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
            Awaiting confirmation of <strong><%= @account.unconfirmed_email %></strong>. Check that inbox for your confirmation link.
          </p>
        <% end %>
      </div>

      <div>
        <%= form.label :password, "New password", class: "block text-sm font-semibold text-slate-900" %>
        <p id="account-password-help" class="mt-1 text-sm text-slate-500">Leave blank to keep your current password. New passwords must have at least <%= User.password_length.min %> characters.</p>
        <%= form.password_field :password,
            value: nil,
            autocomplete: "new-password",
            aria: { describedby: "account-password-help", invalid: @account.errors[:password].any? },
            class: class_names(
              "mt-3 block w-full rounded-lg border bg-white px-4 py-3 shadow-sm transition",
              "border-red-300 focus:border-red-500 focus:ring-red-500" => @account.errors[:password].any?,
              "border-slate-300 focus:border-blue-500 focus:ring-blue-500" => @account.errors[:password].empty?
            ) %>
        <% @account.errors.full_messages_for(:password).each do |message| %>
          <p role="alert" class="mt-2 text-sm text-red-600"><%= message %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm font-semibold text-slate-900" %>
        <%= form.password_field :password_confirmation,
            value: nil,
            autocomplete: "new-password",
            aria: { invalid: @account.errors[:password_confirmation].any? },
            class: class_names(
              "mt-3 block w-full rounded-lg border bg-white px-4 py-3 shadow-sm transition",
              "border-red-300 focus:border-red-500 focus:ring-red-500" => @account.errors[:password_confirmation].any?,
              "border-slate-300 focus:border-blue-500 focus:ring-blue-500" => @account.errors[:password_confirmation].empty?
            ) %>
        <% @account.errors.full_messages_for(:password_confirmation).each do |message| %>
          <p role="alert" class="mt-2 text-sm text-red-600"><%= message %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :current_password, "Current password", class: "block text-sm font-semibold text-slate-900" %>
        <p id="account-current-password-help" class="mt-1 text-sm text-slate-500">Required only when changing your email or password.</p>
        <%= form.password_field :current_password,
            value: nil,
            autocomplete: "current-password",
            aria: { describedby: "account-current-password-help", invalid: @account.errors[:current_password].any? },
            class: class_names(
              "mt-3 block w-full rounded-lg border bg-white px-4 py-3 shadow-sm transition",
              "border-red-300 focus:border-red-500 focus:ring-red-500" => @account.errors[:current_password].any?,
              "border-slate-300 focus:border-blue-500 focus:ring-blue-500" => @account.errors[:current_password].empty?
            ) %>
        <% @account.errors.full_messages_for(:current_password).each do |message| %>
          <p role="alert" class="mt-2 text-sm text-red-600"><%= message %></p>
        <% end %>
      </div>
    </section>

    <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-8 sm:flex-row sm:justify-end">
      <%= link_to "Cancel", lists_path,
          class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <%= form.submit "Save Changes",
          class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700" %>
    </div>
  <% end %>

  <section class="space-y-3 rounded-lg border border-red-200 bg-red-50 p-5">
    <h2 class="text-lg font-semibold text-red-900">Delete Account</h2>
    <p class="text-sm leading-6 text-red-800">Permanently delete your account and its data. You will be asked to confirm your username before anything is deleted.</p>
    <%= link_to "Delete My Account", confirm_delete_account_path,
        class: "inline-block rounded-lg border border-red-300 bg-white px-4 py-2.5 text-sm font-medium text-red-700 hover:bg-red-100" %>
  </section>
</div>
