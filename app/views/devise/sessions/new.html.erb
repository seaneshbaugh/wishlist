<%= render layout: "devise/shared/card", locals: { title: "Wishlist", subtitle: "Sign in to continue." } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <div>
      <%= f.label :email, class: "mb-2 block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email,
        autofocus: true,
        autocomplete: "email",
        class: "block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :password, class: "mb-2 block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password,
        autocomplete: "current-password",
        class: "block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="flex items-center justify-between">
        <label class="flex items-center gap-3 text-sm text-gray-700">
          <%= f.check_box :remember_me,
            class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          <span>Remember me</span>
        </label>
      </div>
    <% end %>
    <%= f.submit "Sign in",
      class: "w-full rounded-lg bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  <% end %>
<% end %>
