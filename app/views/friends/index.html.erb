<div class="mx-auto w-full max-w-5xl">
  <header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Friends</h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-500">Browse your friends' wishlists and connect with people you know.</p>
    </div>
    <%= link_to requests_friendships_path, class: "inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
      </svg>
      Incoming friend requests
    <% end %>
  </header>
  <%= render "friendships/form", email: @email, error: @form_error %>
  <%= render "friends" %>
</div>
