<div class="mx-auto w-full max-w-5xl">
  <header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900">Incoming friend requests</h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-500">Accept a request to share your friends-visible lists with each other.</p>
    </div>
    <%= link_to friends_path, class: "inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 19.5-7.5-7.5m0 0 7.5-7.5M3 12h18" />
      </svg>
      Friends
    <% end %>
  </header>
  <%= render "form", email: @email, error: @form_error %>
  <%= render "requests" %>
</div>
