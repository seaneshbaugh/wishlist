<div
  id="list-items"
  class="mt-8 overflow-hidden rounded-xl border border-slate-200/70 bg-white/60 backdrop-blur-sm"
  data-controller="list-items reorder"
  data-reorder-url-value="<%= reorder_list_list_items_path(@list) %>"
  data-action="dragstart->reorder#dragstart dragover->reorder#dragover dragenter->reorder#dragenter dragleave->reorder#dragleave drop->reorder#drop dragend->reorder#dragend">
  <% if @sort.present? %>
    <%= render partial: "list_items/list_item", collection: @list_items, locals: { show_priority: true } %>
  <% else %>
    <% ListItem.priorities.keys.each do |priority| %>
      <% items = @list_items_by_priority[priority] %>
      <% next if items.blank? %>
      <section
        data-reorder-target="section"
        data-priority="<%= priority %>">
        <div class="border-b border-sky-300/70 bg-sky-200/70 px-6 py-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            <%= priority.humanize %>
          </h2>
        </div>
        <div data-reorder-target="items">
          <% items.select(&:persisted?).each do |list_item| %>
            <%= render "list_items/list_item", list_item: list_item, show_priority: false %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
