<div class="mx-auto w-full max-w-5xl">

  <%# List header %>
  <header class="mb-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">

      <div class="min-w-0">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-semibold tracking-tight text-slate-900">
            <%= @list.name %>
          </h1>

          <% if @list.public? %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
              Public
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              Private
            </span>
          <% end %>
        </div>

        <% if @list.description.present? %>
          <p class="mt-3 max-w-3xl text-base leading-7 text-slate-500">
            <%= @list.description %>
          </p>
        <% end %>

        <p class="mt-4 text-sm text-slate-400">
          <%= pluralize(@list.list_items.size, "item") %>
          · Updated <%= time_ago_in_words(@list.updated_at) %> ago
        </p>
      </div>

      <% if @list.user == current_user %>
        <div class="flex shrink-0 gap-2">
          <%= link_to edit_list_path(@list),
              class: "inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="1.5"
                 stroke="currentColor"
                 class="h-4 w-4">
              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
            </svg>
            Edit list
          <% end %>
        </div>
      <% end %>

    </div>
  </header>


  <%# New item form %>
  <%= render "list_items/form", list: @list, list_item: @list.list_items.build %>


  <%# List items %>
  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200/70 bg-white/60 backdrop-blur-sm">

    <% ListItem.priorities.keys.each do |priority| %>

      <% items = @list_items_by_priority[priority] %>

      <% next if items.blank? %>

      <section>

        <div class="border-b border-slate-200/70 bg-slate-50/70 px-6 py-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            <%= priority.humanize %>
          </h2>
        </div>

        <div>
          <% items.select(&:persisted?).each do |list_item| %>

            <div
              data-list-item-id="<%= list_item.id %>"
              class="group border-b border-slate-200/60 last:border-b-0">

              <div class="flex items-center gap-4 px-6 py-1">

                <%# Drag handle %>
                <% if @list.user == current_user %>
                  <div
                    data-reorder-handle
                    class="flex h-8 w-8 shrink-0 cursor-grab select-none items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-200 hover:text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 rotate-45">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                    </svg>
                  </div>
                <% end %>


                <%# Item content %>
                <div class="min-w-0 flex-1">

                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="font-medium text-slate-900">
                      <%= list_item.name %>
                    </h3>

                    <% if list_item.price.present? %>
                      <span class="text-sm text-slate-500">
                        <%= number_to_currency(list_item.price) %>
                      </span>
                    <% end %>

                    <% if list_item.quantity > 1 %>
                      <span class="text-sm text-slate-400">
                        × <%= list_item.quantity %>
                      </span>
                    <% end %>
                  </div>

                  <% if list_item.notes.present? %>
                    <p class="mt-0.5 truncate text-sm text-slate-500">
                      <%= list_item.notes %>
                    </p>
                  <% end %>

                  <% if list_item.url.present? %>
                    <%= link_to list_item.url,
                        target: "_blank",
                        rel: "noopener noreferrer",
                        class: "mt-0.5 block truncate text-sm text-blue-600 hover:text-blue-700 hover:underline" do %>
                      <%= list_item.url %>
                    <% end %>
                  <% end %>

                </div>

                <%# Actions %>
                <% if @list.user == current_user %>
                  <div class="flex shrink-0 items-center gap-1">

                    <button
                      type="button"
                      data-action="click->list-item#edit"
                      class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-200 hover:text-slate-700"
                      aria-label="Edit <%= list_item.name %>">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                      </svg>
                    </button>

                    <%= button_to list_list_item_path(@list, list_item),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: "Delete this item?"
                          }
                        },
                        class: "flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-red-50 hover:text-red-600",
                        aria: { label: "Delete #{list_item.name}" } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                      </svg>
                    <% end %>

                  </div>
                <% end %>

              </div>
            </div>

          <% end %>
        </div>

      </section>

    <% end %>

  </div>


  <%# New item form %>
  <div class="mt-8">
    <%= render "list_items/form", list: @list, list_item: @list.list_items.build %>
  </div>

</div>
