<header
  data-controller="mobile-menu"
  data-action="keydown.esc@window->mobile-menu#close turbo:before-cache@document->mobile-menu#close"
  class="sticky top-0 z-50 border-b border-slate-200/70 bg-white shadow-sm">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 md:grid md:grid-cols-[1fr_auto_1fr]">
    <div class="justify-self-start">
      <%= link_to root_path, class: "flex items-center gap-3 text-slate-900 hover:text-blue-600" do %>
        <svg
          aria-hidden="true"
          class="h-8 w-8"
          viewBox="0 0 32 32"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M4 6L10 26L16 12L22 26L28 6"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"/>
        </svg>
        <span class="text-xl font-semibold tracking-tight">
          Wishlist
        </span>
      <% end %>
    </div>
    <nav class="justify-self-center hidden items-center gap-8 text-sm font-medium md:flex">
      <%= link_to "Home", root_path, class: "text-slate-600 hover:text-slate-900" %>
      <% if user_signed_in? %>
        <%= link_to "My Lists", lists_path, class: "text-slate-600 hover:text-slate-900" %>
        <%= link_to "Friends", friends_path, class: "text-slate-600 hover:text-slate-900" %>
        <%= link_to "Invitations", invitations_path, class: "text-slate-600 hover:text-slate-900" %>
      <% end %>
      <%= link_to "Help", help_path, class: "text-slate-600 hover:text-slate-900" %>
    </nav>
    <div class="hidden md:block justify-self-end">
      <% if user_signed_in? %>
        <details class="relative">
          <summary class="cursor-pointer list-none rounded-md px-3 py-2 hover:bg-slate-100">
            <%= current_user.username %>
          </summary>
          <div class="absolute right-0 mt-2 w-48 rounded-lg border border-slate-200 bg-white py-2 shadow-lg">
            <%= link_to "Your Account", edit_account_path, class: "block px-4 py-2 hover:bg-slate-50" %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, form_class: "block", class: "w-full px-4 py-2 text-left hover:bg-slate-50" %>
          </div>
        </details>
      <% end %>
    </div>
    <button
      id="mobile-menu-button"
      type="button"
      data-mobile-menu-target="button"
      data-action="mobile-menu#toggle"
      aria-label="Toggle navigation"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="rounded-md p-2 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-blue-600 md:hidden">
      <svg
        aria-hidden="true"
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    data-mobile-menu-target="menu"
    class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-slate-200 bg-white px-6 py-4 text-center md:hidden">
    <div class="mx-auto flex max-w-7xl flex-col gap-2">
      <%= link_to "Home", root_path, class: "rounded px-3 py-3 hover:bg-slate-100" %>
      <% if user_signed_in? %>
        <%= link_to "My Lists", lists_path, class: "rounded px-3 py-3 hover:bg-slate-100" %>
        <%= link_to "Friends", friends_path, class: "rounded px-3 py-3 hover:bg-slate-100" %>
        <%= link_to "Invitations", invitations_path, class: "rounded px-3 py-3 hover:bg-slate-100" %>
        <%= link_to "Your Account", edit_account_path, class: "block px-4 py-2 hover:bg-slate-50" %>
        <%= button_to "Log out", destroy_user_session_path, method: :delete, form_class: "block", class: "w-full px-4 py-2 hover:bg-slate-50" %>
      <% end %>
      <%= link_to "Help", help_path, class: "rounded px-3 py-3 hover:bg-slate-100" %>
    </div>
  </nav>
</header>
