# Copy to dynamic_sites/config/wishlist/app.env; keep the real file untracked.
RAILS_ENV=production
SECRET_KEY_BASE=REPLACE_WITH_GENERATED_SECRET
WISHLIST_HOST=mywishlist.top
DEVISE_MAILER_SENDER=Wishlist <wishlist@mywishlist.top>
# Optional: an existing user's account email, to receive new-account alerts.
# Leave empty to disable these alerts; it is independent of the sender address.
REGISTRATION_NOTIFICATION_EMAIL=
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=2587
SMTP_USERNAME=resend
# Use your Resend API key. Keep this file untracked and in 1Password.
SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
WISHLIST_DATABASE=wishlist_production
WISHLIST_DATABASE_USERNAME=wishlist
# Must match POSTGRES_PASSWORD in db.env.
WISHLIST_DATABASE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
WISHLIST_DATABASE_HOST=wishlistdb
WISHLIST_DATABASE_PORT=5432
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1
# Leave SOLID_QUEUE_IN_PUMA unset: the worker is a separate service.

# database.yml currently evaluates test ENV.fetch entries during production boot.
# These unused placeholders satisfy that evaluation; no test DB is created.
WISHLIST_TEST_DATABASE=wishlist_unused_test
WISHLIST_TEST_DATABASE_USERNAME=unused
WISHLIST_TEST_DATABASE_PASSWORD=unused
WISHLIST_TEST_DATABASE_HOST=127.0.0.1
WISHLIST_TEST_DATABASE_PORT=5432
